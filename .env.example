# ==============================================================================
#                      UMBRELLA OS CONFIGURATION MATRIX
# ==============================================================================

# Core Services
PORT=3000
API_PORT=8000
API_URL=http://localhost:8000

# Database
# If running Docker Compose:
DATABASE_URL=postgresql://umbrella:umbrella_secure_bio@localhost:5432/umbrella_os
# Fallback local SQLite if external Postgres is offline during early bootstrap:
SQLITE_FALLBACK_PATH=data/umbrella_local.db

# Caching & Asynchronous Queue
REDIS_URL=redis://localhost:6379/0

# S3-compatible Object Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=umbrella_admin
MINIO_ROOT_PASSWORD=umbrella_minio_secret_2026
MINIO_BUCKET=umbrella-data
MINIO_SECURE=false

# AI Control Layer (Vella)
# Set GEMINI_API_KEY for online orchestration; defaults to local deterministic provider if omitted
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Bioinformatics Tooling Paths
AMRFINDER_PATH=amrfinder
AMRFINDER_DB=data/raw/amrfinder/latest
XTREE_PATH=xtree

# File Storage & Limits
DATA_ROOT=data
MAX_UPLOAD_MB=2048
# NO default organism — organism comes from real sample metadata or explicit user selection only
# DEFAULT_ORGANISM is intentionally absent per Umbrella OS Hard Rule #1
