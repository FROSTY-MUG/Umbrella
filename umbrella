#!/usr/bin/env bash
# =============================================================================
#  Umbrella OS — Bash CLI Wrapper
# =============================================================================
# Provides the 'umbrella' command in WSL/Linux environments.
# Automatically activates the Python venv if present.
#
# Installation:
#   chmod +x umbrella
#   sudo ln -s $(pwd)/umbrella /usr/local/bin/umbrella
#
# Usage:
#   umbrella doctor
#   umbrella system status
#   umbrella data init|inspect|manifest|download|resume|verify|normalize|annotate|features|benchmark
#   umbrella ml build-features|split|train|evaluate|calibrate|register|promote
#   umbrella amr list-models
#   umbrella lab ...
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
UMBRELLA_PY="$SCRIPT_DIR/umbrella.py"

# Activate venv if present
if [ -f "$SCRIPT_DIR/.venv/bin/activate" ]; then
    source "$SCRIPT_DIR/.venv/bin/activate"
fi

# Execute the Python CLI with all arguments
exec python3 "$UMBRELLA_PY" "$@"
